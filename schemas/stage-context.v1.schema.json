{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dd-eval/stage-context@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "stages"],
  "properties": {
    "schema_id": {"const": "dd-eval/stage-context-blueprint@1"},
    "stages": {
      "type": "object", "additionalProperties": false, "minProperties": 1, "maxProperties": 64,
      "description": "Stage names are declarative identifiers; validateStageBlueprint additionally binds them to the selected flow catalog and checks key/slice identity.",
      "patternProperties": {"^[a-z][a-z0-9-]{0,63}$": {"$ref": "#/$defs/slice"}}
    }
  },
  "$defs": {
    "input": {"type": "object", "additionalProperties": false, "required": ["role", "path", "source", "sha256"], "properties": {"role": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "source": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["role", "root", "path", "reason"], "properties": {"role": {"type": "string", "minLength": 1}, "root": {"enum": ["project", "workspace", "run"]}, "path": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}, "required": {"type": "boolean"}}},
    "slice": {"type": "object", "additionalProperties": false, "required": ["schema_id", "stage", "objective", "task_input", "sources", "accepted_decisions", "dynamic_roles"], "properties": {"schema_id": {"const": "dd-eval/stage-context@1"}, "stage": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}, "objective": {"type": "string", "minLength": 1}, "task_input": {"type": "array", "items": {"$ref": "#/$defs/input"}}, "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}}, "accepted_decisions": {"type": "array"}, "dynamic_roles": {"type": "array"}}}
  }
}
