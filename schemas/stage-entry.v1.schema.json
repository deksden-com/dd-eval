{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dd-eval/stage-entry@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "case_id", "revision", "checkpoint_id", "stage", "snapshot", "context_slice_sha256", "semantic_package_sha256"],
  "properties": {
    "schema_id": {"const": "dd-eval/stage-entry@1"},
    "case_id": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "pattern": "^REV-[0-9]{3,}$"},
    "checkpoint_id": {"type": "string", "minLength": 1},
    "stage": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$", "description": "Declarative stage identity; validateEntry additionally binds it to the selected flow catalog and initial snapshot boundary."},
    "snapshot": {"type": "object", "additionalProperties": false, "required": ["kind", "locator", "manifest_sha256", "run_id"], "properties": {"kind": {"enum": ["bootstrap", "run"]}, "locator": {"type": "string", "minLength": 1}, "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "run_id": {"type": ["string", "null"]}}},
    "engine": {"type": "object", "description": "Deprecated authoring provenance accepted only for historical entries."},
    "context_slice_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "semantic_package_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
