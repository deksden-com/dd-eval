{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dd-eval/run-candidate@2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "run_id", "manifest_sha256", "outcome", "executions", "frozen_at", "immutable_hash"],
  "properties": {
    "schema_id": {"const": "dd-eval/run-candidate@2"},
    "run_id": {"type": "string", "minLength": 1},
    "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "outcome": {"enum": ["complete", "incomplete"]},
    "frozen_at": {"type": "string", "minLength": 1},
    "immutable_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "parent_candidate_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "subject_history_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "executions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["execution", "stage", "run_id", "session_id", "outcome", "reached_stage", "failure", "evidence_completeness", "checkpoint"],
        "properties": {
          "execution": {"type": "string", "minLength": 1},
          "stage": {"type": ["string", "null"]},
          "run_id": {"type": ["string", "null"]},
          "session_id": {"type": ["string", "null"]},
          "outcome": {"type": "string", "minLength": 1},
          "reached_stage": {"type": ["string", "null"]},
          "failure": {"type": ["object", "null"]},
          "evidence_completeness": {"enum": ["checkpointed", "partial", "missing"]},
          "checkpoint": {"type": ["object", "null"]},
          "execution_operation_id": {"type": ["string", "null"]},
          "experiment_conformance": {"type": "object", "required": ["state", "contract_sha256"], "properties": {"state": {"enum": ["matched", "mismatched", "unknown"]}, "contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
          "incomplete_evidence": {"type": ["object", "null"]},
          "recovery": {"type": ["object", "null"]},
          "case_acceptance": {
            "type": "object", "additionalProperties": false,
            "required": ["file", "sha256", "status"],
            "properties": {"file": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "status": {"enum": ["passed", "failed", "not_applicable", "unavailable"]}}
          }
        }
      }
    }
  }
}
