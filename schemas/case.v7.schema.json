{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dd-eval/case@7",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "suite_id", "id", "assessment", "input", "input_checkpoint", "entry_pack", "profiles", "flow"],
  "properties": {
    "schema_id": {"const": "dd-eval/case@7"},
    "suite_id": {"type": "string", "minLength": 1},
    "id": {"type": "string", "minLength": 1},
    "assessment": {"type": "string", "minLength": 1},
    "input": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/input"}},
    "input_checkpoint": {"$ref": "#/$defs/input_checkpoint"},
    "entry_pack": {"type": ["string", "null"]},
    "profiles": {"type": "object"},
    "flow": {"type": "object"}
  },
  "$defs": {
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "source", "sha256"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "input_checkpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": {
        "id": {"type": "string", "pattern": "^cp-[a-z0-9][a-z0-9-]*$"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
