{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dd-eval/run-profile@1",
  "type": "object",
  "additionalProperties": false,
  "allOf": [{"properties": {"subject": {"not": {"anyOf": [{"required": ["memory_init", "execution"]}, {"required": ["memory_upgrade", "execution"]}, {"required": ["memory_init", "memory_upgrade"]}, {"required": ["diagnostic", "execution"]}, {"required": ["diagnostic", "memory_init"]}, {"required": ["diagnostic", "memory_upgrade"]}]}}}}],
  "required": ["schema_id", "id", "case_id", "subject", "selection", "judge", "concurrency", "failure_policy"],
  "properties": {
    "operational_decision": {"type": "object", "additionalProperties": false, "required": ["schema_id", "id", "settings", "policy", "acceptance"], "properties": {"schema_id": {"const": "run-operational-decision@1"}, "id": {"type": "string", "minLength": 1}, "settings": {"type": "object"}, "policy": {"type": "object"}, "acceptance": {"type": "object"}, "exception": {"type": "object"}}},
    "schema_id": {"const": "dd-eval/run-profile@1"},
    "id": {"type": "string", "minLength": 1}, "case_id": {"type": "string", "minLength": 1},
    "subject": {"type": "object", "additionalProperties": false, "required": ["profile_id"], "dependentSchemas": {"diagnostic": {"not": {"required": ["execution"]}}, "distillation": {"not": {"required": ["execution"]}}, "interactive": {"not": {"required": ["execution"]}}}, "dependentRequired": {"memory_init": ["memory_setup"], "memory_upgrade": ["memory_setup"], "diagnostic": ["memory_setup"], "distillation": ["memory_setup"], "interactive": ["memory_setup"]}, "allOf": [{"if": {"required": ["memory_setup"]}, "then": {"oneOf": [{"required": ["memory_init"]}, {"required": ["memory_upgrade"]}, {"required": ["diagnostic"]}, {"required": ["distillation"]}, {"required": ["interactive"]}]}}, {"if": {"required": ["memory_upgrade"]}, "then": {"properties": {"memory_setup": {"required": ["baseline"]}}}}, {"if": {"anyOf": [{"required": ["memory_init"]}, {"required": ["diagnostic"]}, {"required": ["distillation"]}, {"required": ["interactive"]}]}, "then": {"properties": {"memory_setup": {"not": {"required": ["baseline"]}}}}}], "properties": {
      "profile_id": {"type": "string", "minLength": 1},
      "execution": {"type": "object", "description": "Complete CLI routing; dd-eval freezes repo model/reasoning with validated same-ID runtime policy templates before preparing the frozen dd-flow RUN."},
      "memory_setup": {"type": "object", "additionalProperties": false, "required": ["canonSource", "trustFile"], "properties": {"canonSource": {"type": "string", "minLength": 1}, "trustFile": {"type": "string", "minLength": 1}, "channel": {"enum": ["stable", "preview", "development"]}, "baseline": {"type": "object", "additionalProperties": false, "required": ["canonSource", "trustFile"], "properties": {"canonSource": {"type": "string", "minLength": 1}, "trustFile": {"type": "string", "minLength": 1}, "channel": {"enum": ["stable", "preview", "development"]}}}}},
      "memory_upgrade": {"$ref": "#/properties/subject/properties/memory_init"},
      "distillation": {"$ref": "#/properties/subject/properties/diagnostic"},
      "interactive": {"$ref": "#/properties/subject/properties/diagnostic"},
      "diagnostic": {"allOf": [{"$ref": "#/properties/subject/properties/memory_init"}, {"properties": {"maxParallel": {"maximum": 64}}, "not": {"anyOf": [{"required": ["delegation"]}, {"required": ["allowLiveProbe"]}, {"required": ["nativeConfigHome"]}]}}]},
      "memory_init": {"type": "object", "additionalProperties": false, "properties": {"delegation": {"enum": ["external", "native"]}, "allowLiveProbe": {"type": "boolean"}, "nativeConfigHome": {"type": "string", "minLength": 1}, "maxParallel": {"type": "integer", "minimum": 1, "maximum": 256}, "profile": {"type": "string", "minLength": 1}, "profileFile": {"type": "string", "minLength": 1}, "stageProfiles": {"type": "array", "items": {"type": "string", "minLength": 1}}, "workProfiles": {"type": "array", "items": {"type": "string", "minLength": 1}}}, "oneOf": [{"required": ["profile"], "not": {"required": ["profileFile"]}}, {"required": ["profileFile"], "not": {"required": ["profile"]}}]}
    }},
    "selection": {"type": "object", "additionalProperties": false, "required": ["focused_stages", "segment", "e2e", "repetitions"], "properties": {"focused_stages": {"type": "array", "items": {"type": "string"}}, "segment": {"type": ["object", "null"]}, "e2e": {"type": "boolean"}, "repetitions": {"type": "integer", "minimum": 1}}},
    "judge": {"type": "object", "additionalProperties": false, "required": ["enabled"], "properties": {"enabled": {"type": "boolean"}, "profile_id": {"type": "string"}}},
    "interaction_judge": {"type": "object", "additionalProperties": false, "required": ["profile_id"], "properties": {"profile_id": {"type": "string", "minLength": 1}, "verdict_contract": {"enum": ["dd-eval/hitl-match@3", "dd-eval/hitl-coverage@1"]}, "coverage_policy": {"type": "string", "minLength": 1}}, "dependentRequired": {"coverage_policy": ["verdict_contract"]}, "allOf": [{"if": {"required": ["coverage_policy"]}, "then": {"properties": {"verdict_contract": {"const": "dd-eval/hitl-coverage@1"}}}}]},
    "concurrency": {"type": "object", "additionalProperties": false, "required": ["global"], "properties": {"global": {"type": "integer", "minimum": 1}, "per_harness": {"type": "object"}}},
    "failure_policy": {"type": "object"}
  }
}
