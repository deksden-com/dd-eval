{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dd-eval/entry-pack@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "case_id", "revision", "title", "input_checkpoint", "flow", "authoring", "stage_context", "entries", "hashes", "status", "acceptance_sha256"],
  "properties": {
    "schema_id": {"const": "dd-eval/entry-pack@1"}, "case_id": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "pattern": "^REV-[0-9]{3,}$"}, "title": {"type": "string", "minLength": 1},
    "input_checkpoint": {"type": "object"}, "flow": {"type": "object"}, "authoring": {"type": "object"},
    "stage_context": {"type": "string", "minLength": 1},
    "entries": {"type": "object", "additionalProperties": false, "minProperties": 1, "maxProperties": 65, "description": "Bounded entry identifiers; validateEntryPack additionally verifies exact ordered contour coverage and the initial E2E boundary.", "patternProperties": {"^[a-z][a-z0-9-]{0,63}$": {"type": "string", "minLength": 1}}},
    "hashes": {"type": "object"}, "status": {"enum": ["candidate", "accepted"]}, "accepted_at": {"type": "string"},
    "acceptance_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "allOf": [{"if": {"properties": {"status": {"const": "accepted"}}}, "then": {"required": ["accepted_at"]}}]
}
