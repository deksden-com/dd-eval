{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dd-eval/hitl-match@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "status", "response_ids", "uncovered_questions", "rationale"],
  "properties": {
    "schema_id": {"const": "dd-eval/hitl-match@1"},
    "status": {"enum": ["matched", "unmatched"]},
    "response_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "uncovered_questions": {"type": "array", "items": {"type": "string"}},
    "rationale": {"type": "string"}
  }
}
